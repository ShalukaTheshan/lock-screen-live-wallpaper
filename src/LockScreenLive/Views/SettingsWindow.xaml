<Window x:Class="LockScreenLive.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:LockScreenLive.Views.Widgets"
        Title="Lock Screen Live — Settings"
        Width="760"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="#F3F3F3">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0067C0" />
        <LinearGradientBrush x:Key="NoVideoBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B3A67" Offset="0" />
            <GradientStop Color="#7A3B69" Offset="0.6" />
            <GradientStop Color="#E07A5F" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#D6D6D6" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <!-- Widget picker cards: the selected one gets an accent outline. -->
        <Style x:Key="WidgetCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outline" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Padding="4"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="#B8C9E0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Outline" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button Content="Test now" HorizontalAlignment="Left" Click="OnTestNow"
                    ToolTip="Show the live lock screen with these settings. Any input then locks Windows." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>
            <GroupBox Header="Video">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowse" Margin="8,0,0,0" />
                        <TextBox x:Name="VideoPathBox"
                                 Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnPreviewInputChanged" />
                    </DockPanel>
                    <CheckBox Margin="0,10,0,2" Content="Set the Windows lock screen image to a frame of this video"
                              IsChecked="{Binding SyncLockImage}" />
                    <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                        <TextBlock Text="Frame at" VerticalAlignment="Center" />
                        <TextBox Width="60" Margin="6,0"
                                 Text="{Binding LockImageFrameSeconds}"
                                 LostFocus="OnPreviewInputChanged" />
                        <TextBlock Text="seconds" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="20,6,0,0"
                               Text="This is the picture you see after the video, when you sign in. Turn off Windows Spotlight in Settings › Personalization › Lock screen so it sticks." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Widget">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="384" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Live preview: the video frame with the selected widget, exactly as on the lock screen. -->
                        <Border Width="384" Height="216" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource NoVideoBackground}">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                                <widgets:WidgetHost x:Name="PreviewWidget" />
                                <TextBlock x:Name="PreviewStatus" Foreground="#DDD" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Font" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FontBox" Grid.Column="1" Margin="0,3" SelectionChanged="OnWidgetOptionChanged"
                                      MaxDropDownHeight="360">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{Binding Family}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Family}" Value="{x:Null}">
                                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,6">
                                <Button Content="Load font file…" HorizontalAlignment="Left" Click="OnLoadFont"
                                        ToolTip="Use a .ttf or .otf file, e.g. Anurati" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource FieldLabel}" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <TextBlock x:Name="SizeLabel" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="SizeSlider" Minimum="50" Maximum="200" TickFrequency="10"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="OnWidgetOptionChanged" />
                            </DockPanel>

                            <TextBlock Grid.Row="3" Text="Position" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PositionBox" Grid.Row="3" Grid.Column="1" Margin="0,3"
                                      SelectionChanged="OnWidgetOptionChanged">
                                <ComboBoxItem Content="Widget default" />
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Center" />
                                <ComboBoxItem Content="Bottom" />
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Color" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ColorBox" Grid.Row="4" Grid.Column="1" Margin="0,3"
                                      SelectionChanged="OnWidgetOptionChanged">
                                <ComboBoxItem Content="White" />
                                <ComboBoxItem Content="Warm white" />
                                <ComboBoxItem Content="Black" />
                            </ComboBox>

                            <CheckBox x:Name="Use24HourBox" Grid.Row="5" Grid.Column="1" Content="24-hour time"
                                      Checked="OnWidgetOptionChanged" Unchecked="OnWidgetOptionChanged" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="Choose a widget" Margin="0,14,0,6" FontWeight="SemiBold" />
                    <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource WidgetCard}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnWidgetSelected">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When to show it">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="After idle for" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Width="60" Margin="8,3" Text="{Binding IdleMinutes}" />
                    <TextBlock Grid.Column="2" Text="minutes (0 = never)" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="Hotkey" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="140" Margin="8,3" IsReadOnly="True"
                             Text="{Binding Hotkey}"
                             PreviewKeyDown="OnHotkeyKeyDown"
                             GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                             ToolTip="Click, then press a key combination (with Ctrl, Alt, Shift or Win). Backspace clears it." />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center"
                               Text="Use instead of Win+L to lock with the video" />

                    <TextBlock Grid.Row="2" Text="Lock for real after" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="60" Margin="8,3" Text="{Binding MaxOverlayMinutes}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes of video (lets the display sleep)" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Don't start automatically when">
                <StackPanel>
                    <CheckBox Content="A full-screen app, game, or presentation is running" IsChecked="{Binding SkipWhenFullscreen}" />
                    <CheckBox Content="An app is keeping the display on (e.g. video playback)" IsChecked="{Binding SkipWhenDisplayRequired}" />
                    <CheckBox Content="Running on battery" IsChecked="{Binding SkipOnBattery}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Display">
                <WrapPanel>
                    <CheckBox Content="Mute" IsChecked="{Binding Muted}" Margin="0,4,24,4" />
                    <CheckBox Content="All monitors" IsChecked="{Binding AllMonitors}" Margin="0,4,24,4" />
                    <CheckBox Content="Fill screen (crop)" IsChecked="{Binding FillScreen}" Margin="0,4,24,4" />
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,4,24,4" />
                </WrapPanel>
            </GroupBox>

            <TextBlock Style="{StaticResource Hint}" Margin="2,0,2,8"
                       Text="The video is a visual layer. The first key press, click, or mouse movement locks Windows for real, and the normal sign-in screen protects your PC." />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
