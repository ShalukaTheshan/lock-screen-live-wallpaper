<Window x:Class="LockScreenLive.Views.VideoLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:LockScreenLive.Views"
        Title="Live Lock Screen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        Cursor="None">
    <vlc:VideoView x:Name="VideoView" Background="Black">
        <views:ClockOverlay x:Name="Clock" />
    </vlc:VideoView>
</Window>
