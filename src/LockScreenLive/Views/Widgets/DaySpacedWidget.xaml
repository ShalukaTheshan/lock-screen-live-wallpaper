<widgets:WidgetBase x:Class="LockScreenLive.Views.Widgets.DaySpacedWidget"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:LockScreenLive.Views.Widgets"
                    xmlns:controls="clr-namespace:LockScreenLive.Controls">
    <StackPanel>
        <controls:SpacedText x:Name="DayText"
                             FontSize="120"
                             Tracking="0.4"
                             HorizontalAlignment="Center" />
        <controls:SpacedText x:Name="DateText"
                             FontFamily="Segoe UI Variable Display, Segoe UI"
                             FontWeight="SemiBold"
                             FontSize="26"
                             Tracking="0.14"
                             Margin="0,26,0,0"
                             HorizontalAlignment="Center" />
        <controls:SpacedText x:Name="TimeText"
                             FontFamily="Segoe UI Variable Display, Segoe UI"
                             FontWeight="SemiBold"
                             FontSize="24"
                             Tracking="0.14"
                             Margin="0,14,0,0"
                             HorizontalAlignment="Center" />
    </StackPanel>
</widgets:WidgetBase>
